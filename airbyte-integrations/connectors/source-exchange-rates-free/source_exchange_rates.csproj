<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon />
    <OutputType>Exe</OutputType>
    <StartupObject />
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalCdk)' == 'true'">
    <ProjectReference Include="..\..\..\Airbyte.Cdk\Airbyte.Cdk.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalCdk)' != 'true'">
    <PackageReference Include="Airbyte.Cdk" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Flurl.Http" />
    <PackageReference Include="JsonPointer.Net" />
  </ItemGroup>

  <ItemGroup>
    <None Update="schemas\historical.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="schemas\latest.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="schemas\symbols.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="spec.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
