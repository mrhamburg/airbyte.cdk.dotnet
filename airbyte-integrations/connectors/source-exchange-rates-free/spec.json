{
  "documentationUrl": "https://www.frankfurter.app/docs",
  "connectionSpecification": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Frankfurter Source Spec",
    "type": "object",
    "required": [],
    "additionalProperties": false,
    "properties": {
      "start_date": {
        "type": "string",
        "description": "Start getting historical data from this date.",
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
        "examples": ["2024-01-01"]
      },
      "base": {
        "type": "string",
        "description": "ISO reference currency or a comma-separated list of currencies. See the Frankfurter API documentation for the supported currencies.",
        "examples": ["EUR", "USD", "USD,EUR"]
      }
    }
  }
}
