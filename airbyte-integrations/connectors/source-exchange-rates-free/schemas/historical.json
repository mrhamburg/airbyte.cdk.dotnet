{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number"
    },
    "base": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "rates": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "null"]
      }
    }
  },
  "required": ["amount", "base", "date", "rates"]
}
