<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon />
    <OutputType>Exe</OutputType>
    <StartupObject />
  </PropertyGroup>

  <ItemGroup>
    <!-- Temporary: connectors normally reference the published Airbyte.Cdk package (see Directory.Packages.props).
         Substreams (SubstreamDependency) are not in a published version yet; switch back to
         <PackageReference Include="Airbyte.Cdk" /> as soon as 0.0.9 is on nuget.org. -->
    <ProjectReference Include="..\..\..\Airbyte.Cdk\Airbyte.Cdk.csproj" />
    <PackageReference Include="Flurl.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="source_jortt.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="source_jortt.Tests\**" />
    <None Remove="source_jortt.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="schemas\**\*.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="spec.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>