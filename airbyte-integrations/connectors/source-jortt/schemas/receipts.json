    "id": {
      "type": [
        "null",
        "string"
      ]
    },
    "description": {
      "type": [
        "null",
        "string"
      ]
    },
    "file_type": {
      "type": [
        "null",
        "string"
      ]
    },
    "file_size": {
      "type": [
        "null",
        "integer"
      ]
    },
    "expense_id": {
      "type": [
        "null",
        "string"
      ]
    },
    "in_inbox": {
      "type": [
        "null",
        "boolean"
      ]
    },
    "created_at": {
      "type": [
        "null",
        "string"
