<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="mrhamburg.SecretsManager" />
    <PackageReference Include="Parquet.Net" />
    <PackageReference Include="mrhamburg.SecretsManager.PostgreSql" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\Airbyte.Cdk\Protos\*.proto" ProtoRoot="..\..\Airbyte.Cdk\Protos"
              GrpcServices="None" />
  </ItemGroup>

</Project>